<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Entitlements for the ldid pseudo-signature. The keychain group lets the app keep its session in the
	     keychain (securityd refuses SecItem calls without one: -25308). -->
	<key>application-identifier</key>
	<string>com.samcejko.wazzup</string>
	<key>keychain-access-groups</key>
	<array>
		<string>com.samcejko.wazzup</string>
	</array>
	<key>get-task-allow</key>
	<true/>
</dict>
</plist>
